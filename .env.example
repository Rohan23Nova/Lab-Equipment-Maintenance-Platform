# ==============================================================================
# LabLedger Environment Variables Template
# Copy this file to .env for local development:
#   cp .env.example .env
# NEVER commit real credentials, passwords, or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=labledger
DB_USER=labledger_user
DB_PASSWORD=local_dev_password_change_me
DB_POOL_SIZE=10

# ------------------------------------------------------------------------------
# Spring Boot Application Server Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Security & Initial Admin Seed Credentials (DEV ONLY)
# ------------------------------------------------------------------------------
# Default admin user created on first startup in local dev
INITIAL_ADMIN_EMAIL=admin@university.edu
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!

# ------------------------------------------------------------------------------
# Frontend Application Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_TITLE="LabLedger - University Lab Platform"

# ------------------------------------------------------------------------------
# Email / Notification SMTP Configuration (Optional in Dev)
# ------------------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@university.edu
