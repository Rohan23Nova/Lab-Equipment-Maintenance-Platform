# EditorConfig helps maintain consistent coding styles across various editors and IDEs
# More information at: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Java source files
[*.java]
indent_size = 4
indent_style = space

# Build tools & XML configuration
[pom.xml]
indent_size = 4
indent_style = space

[*.xml]
indent_size = 4
indent_style = space

# Frontend TypeScript and JavaScript
[*.{ts,tsx,js,jsx}]
indent_size = 2
indent_style = space

# JSON files
[*.json]
indent_size = 2
indent_style = space

# YAML configuration files
[*.{yml,yaml}]
indent_size = 2
indent_style = space

# Markdown documentation
[*.md]
indent_size = 2
indent_style = space
trim_trailing_whitespace = false

# SQL migration scripts
[*.sql]
indent_size = 4
indent_style = space
