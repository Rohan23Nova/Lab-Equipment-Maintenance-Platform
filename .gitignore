# ==============================================================================
# LabLedger .gitignore
# Covers Java/Maven, React/Node/Vite, IDEs, OS, logs, and sensitive environments.
# ==============================================================================

# ------------------------------------------------------------------------------
# Java & Maven
# ------------------------------------------------------------------------------
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------------------------
# Node & Frontend (Vite, React, TypeScript)
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Test & Coverage Outputs
coverage/
*.lcov
.nyc_output/
jacoco.exec
target/site/jacoco/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
*.pem
*.key
*.crt
*.keystore
*.jks

# Allow committing template environment files
!.env.example

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# Visual Studio Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# Eclipse
.project
.classpath
.settings/
bin/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# Docker & Database local data
# ------------------------------------------------------------------------------
.docker/
docker-data/
postgres-data/
